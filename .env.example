# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file to Git.
# ---------------------------------------------------------------------------

# Path to the Tesseract executable.
# Leave blank on Linux/Mac if Tesseract is already on your system PATH.
# On Windows, this is often something like:
#   C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Groq API key for the plain-language explanation (optional: without a key
# the app shows a built-in template explanation).
# Free, no card: https://console.groq.com/keys  (the key starts with gsk_)
GROQ_API_KEY=

# Optional: leave blank to use the default model (retired names are replaced automatically).
GROQ_MODEL=
