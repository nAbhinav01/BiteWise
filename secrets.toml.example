# Copy these into Streamlit Community Cloud: App -> Settings -> Secrets
# (or save as .streamlit/secrets.toml for local runs - never commit that file)
# Free key (no card): https://console.groq.com/keys  - it starts with gsk_
GROQ_API_KEY = "gsk_your-key-here"
# GROQ_MODEL = "llama-3.3-70b-versatile"   # optional; if a name is retired the app finds a working one itself
